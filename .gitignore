# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env.local

test-results/
playwright-report/

# Android signing key — NEVER commit. Losing this after the first Play Store
# upload means the app can never be updated again under the same identity.
# Store the real copy in a password manager + as a GitHub Actions secret.
android/*.keystore
android/*.jks
android_keystore_password.txt
# Build artifacts: large, regenerated from careerrai.in on every build, and a
# signed bundle in git history is a signing-key question nobody wants to answer.
*.aab
*.apk
android/app/build/
android/build/

# Dev-server / test scratch output. Regenerated on every run; a committed copy
# is stale within the hour and only ever misleads a later reader. Ignored so
# `npm run dev > dev-server.log` can never put them back in git.
dev-server.log
dev-output.log
test-results.log
